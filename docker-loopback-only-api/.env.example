# Copy this file to .env and change both values. Compose reads .env by itself.
# .env is ignored by git, so the token is never committed.

# The bearer token the API requires. Use a long random string: openssl rand -hex 32
API_TOKEN=replace-with-a-long-random-string

# The one host address the proxy's port is published on. 127.0.0.1 keeps it on
# the host. To let another machine in, use the host's own network address.
HOST_ADDRESS=127.0.0.1
